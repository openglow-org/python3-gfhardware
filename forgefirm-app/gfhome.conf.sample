# SPDX-License-Identifier: MIT
# gfhome - Glowforge web-service homing configuration.
# Copied to /data/etc/gfhome.conf on first run; edit the copy.
# Machine identity (serial/password) is read from the OCOTP fuses;
# gf_serial / gf_password in /data/forgefirm.conf (the forgectrl UI,
# GF Cloud tab) override it. The service hostname always derives from
# whichever serial is in effect.

[SERVICE]
server_url: https://app.glowforge.com
status_service_url: wss://status.glowforge.com
# The User-Agent the service sees. Unset = ForgeFIRM/<version>, the version
# from the image stamp /etc/forgefirm-version.
# user_agent: ForgeFIRM/0.0.1

[FACTORY_FIRMWARE]
# check: probe the firmware version the service advertises so forgectrl can
# warn when Glowforge has moved past the version this release was tested
# against. Read-only - ForgeFIRM never downloads or installs factory firmware.
check: True
# Where the probe records {latest_gf_version, tested_against_gf}; forgectrl
# reads this for the cloud-mode compatibility banner (GF_LATEST_FILE).
status_file: /data/forgefirm/gf-latest.json

[LOGGING]
# gfhome and gfcloud log through syslog under their own program names;
# rsyslog files them under /data/log/forgefirm/<name>/ at the levels set
# in the control panel (log_gfhome_* / log_gfcloud_* in
# /data/forgefirm.conf, applied at reboot). Nothing to set here.
# Optional debug captures (raw pulse files, the images sent to the
# service) land in capture_dir (default /data/forgefirm/captures/<name>).
save_puls: False
save_sent_images: False

[THERMAL]
# Thermal policy (fans, pump, TEC, heater) belongs to the forgectrl
# cooling engine; only the start-gate ceiling lives here.
# Real-temperature ceiling; the coolant conversion reads true degrees C.
max_start_temp: 27

[MOTION]
# Extra lens half-steps applied after the hunt (0 = hall reference).
z_home_offset: 0
# A print's warm-up and its rest, in seconds. The defaults are the factory's
# own: 3.05 s of warm-up between configuring the run and starting it, and
# about 10.35 s of rest after the park. The warm-up gets air and coolant moving before the first fire and the
# rest purges the enclosure and the tube after the last one, so a machine
# that skips them is running hardware the service assumes was looked after.
# 0 skips either.
warm_up_delay: 3
cool_down_delay: 10

[FORGECTRL]
# Camera captures fetch from the forgectrl daemon (it owns the camera
# pipeline); direct V4L2 capture is the fallback.
url: http://127.0.0.1
